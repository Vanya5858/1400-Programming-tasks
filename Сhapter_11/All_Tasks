                        }
                    }
                }
                break;
            }
        }
        if (duplicateCount > 0) break;
    }

    if (duplicateCount == 1)
        cout << "В массиве есть только два одинаковых элемента: " << duplicateValue << endl;
    else
        cout << "В массиве более двух одинаковых элементов или их нет.\n";

