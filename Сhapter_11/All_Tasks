// Функция проверки, является ли число простым
bool isPrime(int n) {
    if (n < 2) return false;
    for (int i = 2; i * i <= n; i++) {
        if (n % i == 0) return false;
    }
    return true;
}

int main() {
    setlocale(LC_ALL, "RU");

    // а) 20 первых чисел, делящихся на 15 или 17, начиная с 500
