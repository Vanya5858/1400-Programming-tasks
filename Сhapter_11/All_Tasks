    const int SIZE_A = 20;
    int divArr[SIZE_A];

    int count = 0;
    int num = 500;

    while (count < SIZE_A) {
        if (num % 15 == 0 || num % 17 == 0) {
            divArr[count] = num;
            count++;
        }
        num++;
    }

    cout << "Массив: " << endl;
    for (int i = 0; i < SIZE_A; i++) {
        cout << divArr[i] << " ";
        if ((i + 1) % 5 == 0) cout << endl;
