            int product = digits[j] * 2 + carry;
            digits[j] = product % 10;
            carry = product / 10;
        }
        
        // Добавляем новый разряд при необходимости
        while (carry > 0) {
            digits.push_back(carry % 10);
            carry /= 10;
        }
    }
    
    // Выводим результат
    cout << "\n2^" << N << " = ";
    for (int i = digits.size() - 1; i >= 0; i--) {
        cout << digits[i];
