        if (temp[i] > temp[maxIndex]) maxIndex = i;
        if (temp[i] < temp[minIndex]) minIndex = i;
    }

    int start = (maxIndex < minIndex) ? maxIndex : minIndex;
    int end = (maxIndex > minIndex) ? maxIndex : minIndex;

    for (int i = start, j = end; i < j; i++, j--) {
        int swap = temp[i];
