int main() {
    setlocale(LC_ALL, "RU");
    // а) Все целые числа от 20 до 35
    cout << "а) Все целые числа от 20 до 35:\n";
    for (int i = 20; i <= 35; i++) {
        cout << i << endl;
    }
    cout << endl;

    // б) Квадраты всех целых чисел от a до 50
    int a;
