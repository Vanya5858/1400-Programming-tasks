    temp = n;
    while (temp > 0) {
        withTwos = withTwos * 10 + (temp % 10);
        temp /= 10;
    }
    withTwos = withTwos * 10 + 2;

    int result = 0;
    temp = withTwos;
    while (temp > 0) {
        result = result * 10 + (temp % 10);
        temp /= 10;
    }
    cout << "б) С двойками в начале и конце: " << result << endl;

    int withoutA = 0;
    int multiplier = 1;
    temp = n;

    while (temp > 0) {
        int digit = temp % 10;
        if (digit != a) {
            withoutA = withoutA + digit * multiplier;
            multiplier *= 10;
        }
        temp /= 10;
    }
