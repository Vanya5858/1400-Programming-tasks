    int temp = a;
    while (temp >= b) {
        temp -= b;
        quotient++;
    }
    cout << "Целочисленное деление: " << quotient << endl;

    // б) Остаток от деления
    int remainder = a;
    while (remainder >= b) {
        remainder -= b;
    }
    cout << "Остаток от деления: " << remainder << endl;

    return 0;
}
